{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Reasoning v1 Arm Result",
  "type": "object",
  "required": ["case_id", "arm_id", "model", "reasoning_effort", "task_success", "validator_success", "semantic_quality", "safety_passed", "input_tokens", "reasoning_tokens", "output_tokens", "cached_tokens", "cache_write_tokens", "latency_ms", "estimated_cost_usd", "retry_count", "fallback_count", "tool_calls", "unique_files_read", "files_modified", "router_compute_ms", "router_preflight_ms", "router_prompt_overhead_tokens", "experiment_fingerprint", "timestamp", "execution_error"],
  "properties": {
    "case_id": {"type": "string"},
    "arm_id": {"type": "string"},
    "model": {"type": "string"},
    "reasoning_effort": {"type": "string"},
    "task_success": {"type": "boolean"},
    "validator_success": {"type": ["boolean", "null"]},
    "semantic_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
    "safety_passed": {"type": "boolean"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "reasoning_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cached_tokens": {"type": "integer", "minimum": 0},
    "cache_write_tokens": {"type": "integer", "minimum": 0},
    "latency_ms": {"type": "number", "minimum": 0},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "fallback_count": {"const": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "unique_files_read": {"type": "integer", "minimum": 0},
    "files_modified": {"type": "integer", "minimum": 0},
    "router_compute_ms": {"type": "number", "minimum": 0},
    "router_preflight_ms": {"type": "number", "minimum": 0},
    "router_prompt_overhead_tokens": {"type": "integer", "minimum": 0},
    "experiment_fingerprint": {"type": "string"},
    "timestamp": {"type": "string"},
    "execution_error": {"type": ["string", "null"]},
    "execution_diagnostic": {"type": ["string", "null"]},
    "requested_model": {"type": "string"},
    "requested_reasoning_effort": {"type": "string"},
    "effective_model": {"type": ["string", "null"]},
    "effective_reasoning_effort": {"type": ["string", "null"]},
    "usage_available": {"type": "boolean"},
    "precheck_success": {"type": "boolean"},
    "outcome_validation_success": {"type": ["boolean", "null"]},
    "semantic_review_state": {"enum": ["not_required", "pending", "not_started_no_candidate"]},
    "execution_backend": {"type": "string"},
    "execution_backend_executable": {"type": ["string", "null"]},
    "execution_backend_cwd": {"type": ["string", "null"]},
    "execution_event_types": {"type": "array", "items": {"type": "string"}}
  }
}
